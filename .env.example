# Power Apps / Dataverse MCP Server Configuration
# Copy this file to .env and fill in your values

# Your Dataverse environment URL (without trailing slash)
# Example: https://yourorg.crm.dynamics.com
DATAVERSE_URL=https://yourorg.crm.dynamics.com

# Azure AD Tenant ID
# Find at: Azure Portal > Azure Active Directory > Overview > Tenant ID
AZURE_TENANT_ID=your-tenant-id-here

# Azure AD App Registration Client ID
# Find at: Azure Portal > App Registrations > Your App > Application (client) ID
AZURE_CLIENT_ID=your-client-id-here

# Azure AD App Registration Client Secret
# Find at: Azure Portal > App Registrations > Your App > Certificates & secrets
AZURE_CLIENT_SECRET=your-client-secret-here
